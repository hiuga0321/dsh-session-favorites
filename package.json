{
  "name": "dsh-session-favorites",
  "version": "0.1.1",
  "description": "DSH 会话收藏夹插件：收藏会话、按工作区分组、@ 引入、多设备一致",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/smoke.mjs && node test/schema.test.mjs && node test/favorites-core.test.mjs && node test/client.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiuga0321/dsh-session-favorites.git"
  },
  "homepage": "https://github.com/hiuga0321/dsh-session-favorites#readme",
  "bugs": {
    "url": "https://github.com/hiuga0321/dsh-session-favorites/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-session-reference": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-reference": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.2"
  },
  "license": "MIT",
  "author": "hiuga0321",
  "engines": {
    "dsh": ">=0.1.5-rc.2 <0.3.0",
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "favorites",
    "session"
  ]
}
